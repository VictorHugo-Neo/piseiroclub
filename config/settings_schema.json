[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Cores da Loja (E-commerce Senior)",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "default": "#F9F8F6",
        "label": "Fundo da Página (Background Principal)"
      },
      {
        "type": "color",
        "id": "color_background_secondary",
        "default": "#FFFFFF",
        "label": "Fundo Secundário (Cartões, Caixas)"
      },
      {
        "type": "color",
        "id": "color_text_primary",
        "default": "#1C1917",
        "label": "Texto Principal (Títulos, Texto Escuro)"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "default": "#78716C",
        "label": "Texto Secundário (Descrições, Muted)"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#5C3D2E",
        "label": "Cor de Destaque (Botões Primários, Links)"
      },
      {
        "type": "color",
        "id": "color_accent_hover",
        "default": "#422A1F",
        "label": "Cor de Destaque Hover (Ação Secundária)"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "default": "#FFFFFF",
        "label": "Texto do Botão Primário"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#E7E5E4",
        "label": "Bordas e Divisores"
