<header class="header">
  <!-- Regra 6: Padrão Z - Logotipo posicionado à esquerda -->
  <a href="{{ routes.root_url }}" class="header__logo">
    {{ shop.name }}
  </a>

  <!-- Regra 6 e 8: Menu centralizado e simplificado (Lei de Hick) sem submenus -->
  <nav class="header__menu" aria-label="Menu Principal">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="header__menu-item">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback com categorias essenciais (Calçados e Acessórios) -->
      <a href="{{ routes.all_products_collection_url }}" class="header__menu-item">Calçados</a>
      <a href="{{ routes.all_products_collection_url }}" class="header__menu-item">Acessórios</a>
    {%- endif -%}
  </nav>

  <!-- Regra 6: Padrão Z - Ícones utilitários posicionados à direita -->
  <div class="header__icons">
    <!-- Ícone de Busca -->
    <a href="{{ routes.search_url }}" class="header__icon" aria-label="Buscar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </a>

    <!-- Ícone de Conta -->
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="header__icon" aria-label="Minha Conta">
        {%- if 'icon-account.svg' != blank -%}
          {{ 'icon-account.svg' | inline_asset_content }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        {%- endif -%}
      </a>
    {%- endif -%}

    <!-- Ícone de Carrinho -->
    <a href="{{ routes.cart_url }}" class="header__icon" aria-label="Carrinho">
      {{ 'icon-cart.svg' | inline_asset_content }}
      {%- if cart.item_count > 0 -%}
        <sup class="header__cart-count">{{ cart.item_count }}</sup>
      {%- endif -%}
    </a>
  </div>
</header>

{% stylesheet %}
  .header {
    background-color: var(--color-background, #f9f6f0);
    box-shadow: 0 4px 15px rgba(92, 42, 30, 0.06); /* Sombreamento leve usando tom Pinhão para harmonia */
    height: 5rem;
    padding: 0 var(--page-margin, 64px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__logo {
    justify-self: start;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-pinhao, #5c2a1e);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .header__menu {
    justify-self: center;
    display: flex;
    gap: 2.5rem;
  }

  .header__menu-item {
    text-decoration: none;
    color: var(--color-foreground, #5c2a1e);
    font-weight: 500;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .header__menu-item:hover {
    opacity: 0.7;
    color: var(--color-whisky, #a9673c);
  }

  .header__icons {
    justify-self: end;
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .header__icon {
    text-decoration: none;
    color: var(--color-foreground, #5c2a1e);
    display: flex;
    align-items: center;
    position: relative;
    transition: opacity 0.2s ease;
  }
  
  .header__icon:hover {
    opacity: 0.7;
    color: var(--color-whisky, #a9673c);
  }

  .header__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .header__cart-count {
    position: absolute;
    top: -0.4rem;
    right: -0.6rem;
    background-color: var(--color-whisky, #a9673c);
    color: #fff;
    font-size: 0.7rem;
    line-height: 1;
    padding: 0.2rem 0.4rem;
    border-radius: 2rem;
    font-weight: 700;
  }

  /* Responsividade básica para manter simplicidade */
  @media screen and (max-width: 768px) {
    .header {
      padding: 0 1.5rem;
      grid-template-columns: 1fr auto; /* Oculta menu no mobile por simplicidade no grid Z */
    }
    
    .header__menu {
      display: none; /* Em um tema completo, aqui entraria um menu hambúrguer */
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho Principal",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu Principal",
      "info": "Para alta conversão (Lei de Hick), prefira links diretos como 'Calçados' e 'Acessórios'. Submenus não serão exibidos."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Menu da Conta de Cliente",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
