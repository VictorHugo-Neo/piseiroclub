<div class="hero-banner full-width">
  <!-- Mídia de Fundo -->
  {%- if section.settings.background_video != blank -%}
    {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero-banner__media' }}
  {%- elsif section.settings.background_image != blank -%}
    <picture>
      <source media="(max-width: 768px)" srcset="{{ section.settings.background_image | image_url: width: 400 }}">
      <source media="(min-width: 769px)" srcset="{{ section.settings.background_image | image_url: width: 2000 }}">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: class: 'hero-banner__media', loading: 'eager' }}
    </picture>
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-banner__media placeholder-svg' }}
  {%- endif -%}

  <!-- Overlay Translúcido para Contraste -->
  <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

  <!-- Conteúdo Centralizado -->
  <div class="hero-banner__content">
    {%- if section.settings.title != blank -%}
      <h1 class="hero-banner__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="hero-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="hero-banner__btn">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 85vh; /* Altura generosa */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .placeholder-svg {
    background-color: var(--color-background, #F9F8F6);
    fill: var(--color-pinhao, #5C3D2E);
  }

  .hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    z-index: 2;
  }

  .hero-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 900px;
    padding: 0 2rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Regra 3: Hierarquia Visual - Título Principal de Grande Destaque */
  .hero-banner__title {
    font-size: clamp(3rem, 5vw + 1rem, 5rem);
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    letter-spacing: -0.02em;
  }

  /* Regra 3: Hierarquia Visual - Subtítulo Menor e de Apoio */
  .hero-banner__subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 300;
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    max-width: 650px;
    opacity: 0.95;
  }

  /* Botão profissional (Country Elegance) */
  .hero-banner__btn {
    display: inline-block;
    background-color: var(--color-whisky, #A67C52);
    color: #ffffff;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 1rem 3rem;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
  }

  .hero-banner__btn:hover,
  .hero-banner__btn:focus {
    background-color: var(--color-foreground, #2D2422); /* Muda para a cor escura no hover, típico do Country Elegance */
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    outline: none;
  }

  @media screen and (max-width: 768px) {
    .hero-banner {
      min-height: 60vh;
    }
    
    .hero-banner__btn {
      width: auto;
      padding: 0.8rem 2rem;
      font-size: 0.95rem;
      margin-top: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner de Destaque",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "Sinta o Ritmo do Forró"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "O par de calçados ideal para você dançar a noite inteira com conforto, firmeza e muito estilo."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de Fundo",
      "info": "Recomendado: Casais dançando forró (Alta Resolução)."
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Vídeo de Fundo",
      "info": "Selecione um vídeo para substituir a imagem. Será reproduzido automaticamente e sem som."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidade do Fundo Escuro (Overlay)",
      "default": 55,
      "info": "Aumente para garantir maior legibilidade do texto e contraste (Regra 3)."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do Botão (CTA)",
      "default": "Ver Calçados"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do Botão"
    }
  ],
  "presets": [
    {
      "name": "Banner de Destaque"
    }
  ]
}
{% endschema %}
