<div class="hero-banner full-width">
  <!-- Mídia de Fundo -->
  {%- if section.settings.background_video != blank -%}
    {{ section.settings.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'hero-banner__media' }}
  {%- elsif section.settings.background_image != blank -%}
    <picture>
      <source media="(max-width: 768px)" srcset="{{ section.settings.background_image | image_url: width: 400 }}">
      <source media="(min-width: 769px)" srcset="{{ section.settings.background_image | image_url: width: 2000 }}">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag: class: 'hero-banner__media', loading: 'eager' }}
    </picture>
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'hero-banner__media placeholder-svg' }}
  {%- endif -%}

  <!-- Overlay Translúcido para Contraste -->
  <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

  <!-- Conteúdo Centralizado -->
  <div class="hero-banner__content">
    {%- if section.settings.title != blank -%}
      <h1 class="hero-banner__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="hero-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="hero-banner__btn">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 80vh;
    display: flex;
    align-items: flex-end; /* Thursday Boots costuma colocar o texto na parte inferior */
    justify-content: center;
    overflow: hidden;
  }

  .hero-banner__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .placeholder-svg {
    background-color: var(--color-background);
    fill: var(--color-accent);
  }

  /* Em vez de uma tela preta em tudo, um gradiente sutil de baixo para cima para destacar o texto */
  .hero-banner__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
    z-index: 2;
  }

  .hero-banner__content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 1000px;
    padding: 0 2rem 4rem 2rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .hero-banner__title {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.5rem, 5vw + 1rem, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  .hero-banner__subtitle {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 300;
    line-height: 1.5;
    margin: 0;
    max-width: 600px;
    letter-spacing: 0.05em;
    opacity: 0.9;
    text-shadow: 0 2px 5px rgba(0,0,0,0.3);
  }

  /* Botão Boutique (Fundo transparente, borda fina) */
  .hero-banner__btn {
    display: inline-block;
    background-color: transparent;
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 1rem 3.5rem;
    border: 1px solid #ffffff;
    cursor: pointer;
    margin-top: 1rem;
    transition: background-color 0.4s ease, color 0.4s ease;
  }

  .hero-banner__btn:hover,
  .hero-banner__btn:focus {
    background-color: #ffffff;
    color: #111111;
    outline: none;
  }

  @media screen and (max-width: 768px) {
    .hero-banner {
      min-height: 70vh;
      align-items: center; /* No mobile fica melhor centralizado */
    }
    
    .hero-banner__overlay {
      height: 100%;
      background: rgba(0,0,0,0.4); /* Overlay sólido suave no mobile para legibilidade */
    }

    .hero-banner__content {
      padding: 0 1.5rem;
    }

    .hero-banner__btn {
      width: 100%;
      padding: 1rem 2rem;
      margin-top: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner de Destaque",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "Elegância & Tradição"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "O legítimo estilo country. Botas artesanais, acessórios premium e vestuário feito para durar."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de Fundo",
      "info": "Recomendado: Imagem de alta resolução com foco em lifestyle ou produto (Ex: textura de couro ou alguém calçando a bota)."
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Vídeo de Fundo",
      "info": "Selecione um vídeo para substituir a imagem. Será reproduzido automaticamente e sem som."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidade do Fundo Escuro (Overlay)",
      "default": 55,
      "info": "Apenas aplicado no mobile se precisar de contraste."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do Botão (CTA)",
      "default": "Explorar Coleção"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do Botão"
    }
  ],
  "presets": [
    {
      "name": "Banner de Destaque"
    }
  ]
}
{% endschema %}
