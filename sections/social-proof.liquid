<div class="social-proof-section">
  <div class="social-proof__header">
    <h2 class="social-proof__title">{{ section.settings.title }}</h2>
  </div>

  <!-- Regra 11: Lei da Proximidade - Fotos unidas como um bloco contínuo -->
  <div class="social-proof__grid">
    {%- for block in section.blocks -%}
      <a href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="social-proof__item" {{ block.shopify_attributes }}>
        
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: class: 'social-proof__image', loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        <!-- Efeito visual minimalista que incentiva o clique e interação com a comunidade -->
        <div class="social-proof__overlay">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>

  <div class="social-proof__footer">
    <!-- Botão Secundário - Sem roubar atenção dos CTAs principais da loja -->
    <a href="{{ section.settings.instagram_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="social-proof__btn">
      {{ section.settings.button_label }}
    </a>
  </div>
</div>

{% stylesheet %}
  .social-proof-section {
    max-width: var(--page-width, 1200px);
    margin: 2rem auto;
    padding: 0 var(--page-margin, 64px);
    display: flex;
    flex-direction: column;
    gap: 3rem; /* Separa claramente o título, o mosaico de fotos e o botão inferior */
  }

  .social-proof__header {
    text-align: center;
  }

  .social-proof__title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: var(--color-pinhao, #5C3D2E);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Regra 11 (Proximidade Gestalt)
     Mosaico coeso sem separações severas para o cérebro unir como 1 único painel social */
  .social-proof__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem; 
  }

  .social-proof__item {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1; /* Mantém a identidade clássica de um feed quadrado (simetria) */
    overflow: hidden;
    background-color: #f0f0f0;
    border-radius: 0; /* Cantos arredondados, leve e moderno */
    display: block;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  }

  .social-proof__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .placeholder-svg {
    width: 100%;
    height: 100%;
    fill: #a0a0a0;
    background-color: #eaeaea;
  }

  /* Overlay Escuro com o logo do Insta aparecendo suavemente no Hover */
  .social-proof__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(92, 42, 30, 0.45); /* A cor Pinhão translúcida */
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .social-proof__overlay svg {
    width: 48px;
    height: 48px;
    color: #fff;
    transform: translateY(10px);
    transition: transform 0.3s ease;
  }

  .social-proof__item:hover .social-proof__overlay {
    opacity: 1;
  }

  .social-proof__item:hover .social-proof__overlay svg {
    transform: translateY(0); /* Anima o ícone subindo */
  }

  .social-proof__item:hover .social-proof__image {
    transform: scale(1.05); /* Efeito zoom de fundo */
  }

  .social-proof__footer {
    text-align: center;
  }

  /* Botão secundário (Visual "Fantasma") para não competir com o CTA "Comprar" */
  .social-proof__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 3.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-pinhao, #5C3D2E);
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.1em;
    border: 2px solid var(--color-pinhao, #5C3D2E);
    border-radius: 0;
    transition: all 0.2s ease;
  }

  .social-proof__btn:hover {
    background-color: var(--color-pinhao, #5C3D2E);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(92, 42, 30, 0.2);
  }

  /* Mobile: O layout se quebra para o scroll horizontal responsivo (Snap effect) */
  @media screen and (max-width: 900px) {
    .social-proof-section {
      padding: 0 0 0 1.5rem; /* Margem apenas lado esquerdo */
      margin: 2rem auto;
    }
    
    .social-proof__header {
      padding-right: 1.5rem;
    }

    .social-proof__footer {
      padding-right: 1.5rem;
    }
    
    .social-proof__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding-bottom: 2rem;
      padding-right: 1.5rem;
      scrollbar-width: none; 
      -ms-overflow-style: none;
    }
    
    .social-proof__grid::-webkit-scrollbar {
      display: none;
    }

    .social-proof__item {
      flex: 0 0 75%; /* Revela a ponta da próxima imagem para instigar a rolagem */
      scroll-snap-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Prova Social (Comunidade)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "Nossa Comunidade no Salão"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do Botão",
      "default": "Siga nosso Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Link do Instagram"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Foto de Cliente",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem",
          "info": "Upload da foto real do cliente no salão (Recomendado 1:1 quadrado)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prova Social (Instagram)",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
