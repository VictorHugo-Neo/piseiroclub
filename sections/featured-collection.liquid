<div class="featured-collection-section">
  <!-- Regra 7: Espaço em Branco - Cabeçalho simples e direto -->
  <div class="featured-collection__header">
    {%- if section.settings.title != blank -%}
      <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="featured-collection__desc">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <!-- Regra 4: Layout baseado em grade (4 itens no desktop, carrossel no mobile) -->
  <div class="featured-collection__grid">
    {%- assign featured_collection = collections[section.settings.collection] -%}
    
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      {%- for product_item in featured_collection.products limit: section.settings.products_to_show -%}
        <!-- Regra 11: Lei da Proximidade - Bloco coeso conectando imagem, título, preço e botão -->
        <a href="{{ product_item.url }}" class="product-card">
          <div class="product-card__image-wrapper">
            {{ product_item.featured_image | image_url: width: 600 | image_tag: class: 'product-card__image', loading: 'lazy' }}
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">{{ product_item.title }}</h3>
            <span class="product-card__price">{{ product_item.price | money }}</span>
            <span class="product-card__btn">Ver Detalhes</span>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback caso nenhuma coleção seja selecionada -->
      {%- for i in (1..4) -%}
        <div class="product-card">
          <div class="product-card__image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">Calçado de Dança</h3>
            <span class="product-card__price">{{ 19990 | money }}</span>
            <span class="product-card__btn">Ver Detalhes</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  
  {%- if section.settings.show_view_all and featured_collection != blank -%}
    <div class="featured-collection__footer">
      <a href="{{ featured_collection.url }}" class="btn-view-all">Ver Toda a Coleção</a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* Regra 7: Espaço em Branco abundante */
  .featured-collection-section {
    max-width: var(--page-width, 1200px);
    margin: 6rem auto; /* Margem superior e inferior generosas para o layout respirar */
    padding: 0 var(--page-margin, 64px);
  }

  .featured-collection__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .featured-collection__title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--color-pinhao, #5c2a1e);
    margin: 0 0 1rem 0;
  }
  
  .featured-collection__desc {
    font-size: 1.1rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Regra 4: Grid Desktop de 4 colunas */
  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  /* Regra 11: Lei da Proximidade */
  .product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-background, #f9f6f0);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 25px rgba(92, 42, 30, 0.12);
  }

  .product-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1; /* Quadrado padronizado */
    overflow: hidden;
    background-color: #f2f2f2;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  
  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .placeholder-svg {
    width: 100%;
    height: 100%;
    fill: #a0a0a0;
  }

  /* Elementos próximos e coesos para facilitar a leitura */
  .product-card__info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem; 
  }

  .product-card__title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-pinhao, #5c2a1e);
    margin: 0;
    text-align: center;
    line-height: 1.3;
  }

  .product-card__price {
    font-size: 1.3rem;
    font-weight: 800;
    color: #1a7b45;
  }

  .product-card__btn {
    margin-top: 0.8rem;
    background-color: var(--color-whisky, #a9673c);
    color: #fff;
    padding: 0.7rem 1.8rem;
    border-radius: 30px;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: 100%;
    text-align: center;
    transition: background-color 0.2s ease;
  }
  
  .product-card:hover .product-card__btn {
    background-color: #8c532f;
  }

  .featured-collection__footer {
    text-align: center;
    margin-top: 3rem;
  }
  
  .btn-view-all {
    display: inline-block;
    padding: 1rem 3rem;
    border: 2px solid var(--color-pinhao, #5c2a1e);
    color: var(--color-pinhao, #5c2a1e);
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.2s ease;
  }
  
  .btn-view-all:hover {
    background-color: var(--color-pinhao, #5c2a1e);
    color: #fff;
  }

  /* Regra 4: Carrossel nativo (Scroll Snap) no Mobile */
  @media screen and (max-width: 900px) {
    .featured-collection-section {
      padding: 0 0 0 1.5rem; /* Margem apenas na esquerda para permitir sangria à direita */
      margin: 4rem auto;
    }
    
    .featured-collection__header {
      padding-right: 1.5rem;
    }
    
    .featured-collection__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1.25rem;
      padding-bottom: 2rem;
      padding-right: 1.5rem;
      scrollbar-width: none; 
      -ms-overflow-style: none;
    }
    
    .featured-collection__grid::-webkit-scrollbar {
      display: none;
    }

    .product-card {
      flex: 0 0 80%; /* Deixa claro que há mais conteúdo à direita */
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coleção em Destaque",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título da Seção",
      "default": "Mais Vendidos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição",
      "default": "Os modelos preferidos para quem não sai do salão."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção",
      "info": "Selecione a coleção que ganhará destaque na home."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Quantidade de produtos a mostrar"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Mostrar botão 'Ver Toda a Coleção'"
    }
  ],
  "presets": [
    {
      "name": "Coleção em Destaque"
    }
  ]
}
{% endschema %}
