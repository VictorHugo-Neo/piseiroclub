<div class="category-list-section">
  <div class="category-list__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
        <div class="category-card__image-wrapper">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 800 | image_tag: class: 'category-card__image', loading: 'lazy' }}
          {% else %}
            {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg category-card__image' }}
          {% endif %}
          <div class="category-card__overlay"></div>
          <h3 class="category-card__title">{{ block.settings.title }}</h3>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .category-list-section {
    max-width: var(--page-width, 1400px); /* Ligeiramente mais largo que o padrão */
    margin: 0 auto;
    padding: 0;
  }

  .category-list__grid {
    display: flex;
    gap: 0.5rem; /* Margem mínima entre categorias, visual bem moderno */
  }

  .category-card {
    flex: 1;
    position: relative;
    text-decoration: none;
    overflow: hidden;
    background: #000;
  }

  .category-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  .category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .category-card:hover .category-card__image {
    transform: scale(1.05);
  }

  /* Overlay escuro elegante */
  .category-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 40%);
    z-index: 1;
  }

  .category-card__title {
    position: absolute;
    bottom: 2rem;
    left: 0;
    width: 100%;
    text-align: center;
    color: #fff;
    font-size: 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .category-list__grid {
      flex-direction: column;
      gap: 0.5rem;
    }
    .category-card__image-wrapper {
      aspect-ratio: 16 / 9; /* Mais horizontal no mobile para caber mais */
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Compre por Categoria",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem de Fundo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título da Categoria",
          "default": "Botas"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link da Coleção"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compre por Categoria",
      "blocks": [
        { "type": "category", "settings": { "title": "Para Ele" } },
        { "type": "category", "settings": { "title": "Para Ela" } },
        { "type": "category", "settings": { "title": "Acessórios" } }
      ]
    }
  ]
}
{% endschema %}
