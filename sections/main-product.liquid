<div class="product-main">
  <!-- Navegação Estrutural (Breadcrumbs) -->
  <nav class="breadcrumb" aria-label="Navegação estrutural">
    <a href="{{ routes.root_url }}">Início</a>
    <span aria-hidden="true">&rsaquo;</span>
    {% if collection %}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span aria-hidden="true">&rsaquo;</span>
    {% endif %}
    <span>{{ product.title }}</span>
  </nav>

  <!-- Regra 5: Padrão F (Esquerda: Galeria, Direita: Informações de Compra) -->
  <div class="product-layout">
    
    <!-- Regra 2: Razão Áurea (~61.8%) - Galeria de Imagens -->
    <div class="product-gallery">
      {%- for media in product.media -%}
        <div class="product-gallery__item">
          <picture>
            <!-- Carrega versão minúscula e econômica (400px) no Mobile -->
            <source media="(max-width: 768px)" srcset="{{ media | image_url: width: 400 }}">
            <!-- Carrega versão Full HD (1200px) no Desktop -->
            <source media="(min-width: 769px)" srcset="{{ media | image_url: width: 1200 }}">
            {{ media | image_url: width: 1200 | image_tag: loading: 'lazy' }}
          </picture>
        </div>
      {%- endfor -%}
    </div>

    <!-- Regra 2: Razão Áurea (~38.2%) - Informações -->
    <div class="product-details">
      <!-- Escassez Premium -->
      {% render 'scarcity-stock' %}
      
      <h1 class="product-title">{{ product.title }}</h1>
      
      <!-- Hierarquia de Preços -->
      <div class="product-pricing">
        <span class="product-price--pix">
          {{ product.price | times: 0.9 | money }} <span class="pix-label">no Pix (10% off)</span>
        </span>
        <span class="product-price--installments">
          ou 12x de {{ product.price | divided_by: 12 | money }}
        </span>
        {% if product.compare_at_price > product.price %}
          <span class="product-price--original">De: <s>{{ product.compare_at_price | money }}</s></span>
        {% endif %}
      </div>
      
      <!-- FOMO Premium: Coração / Carrinho -->
      {% render 'live-views' %}

      <!-- Descrição Técnica em Lista para Escaneabilidade (Padrão F) -->
      <div class="product-description-tech">
        <h3>Especificações Técnicas:</h3>
        <ul>
          <li><strong>Material:</strong> Couro legítimo flexível, ideal para respirabilidade.</li>
          <li><strong>Solado:</strong> Sola de cromo especial para deslizar e girar facilmente no forró.</li>
          <li><strong>Palmilha:</strong> EVA acolchoado garantindo conforto para a noite toda.</li>
          <li><strong>Peso:</strong> Levíssimo, menos de 300g o par.</li>
        </ul>
        <div class="product-description-full">
          {{ product.description }}
        </div>
      </div>

      <!-- Formulário de Compra -->
      <div class="product-form">
        {% form 'product', product %}
          <!-- Variantes / Tamanhos (Pills) -->
          <div class="product-form__variants">
            <div class="product-form__variants-header">
              <label>Selecione o Tamanho</label>
              <button type="button" class="btn-size-guide" onclick="alert('Guia de Tamanhos abriria aqui.')">Guia de Tamanhos</button>
            </div>
            
            <div class="variant-pills">
              {% for variant in product.variants %}
                <input type="radio" 
                       id="variant-{{ variant.id }}" 
                       name="id" 
                       value="{{ variant.id }}" 
                       {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
                       {% unless variant.available %}disabled{% endunless %}
                       class="variant-pill__input">
                <label for="variant-{{ variant.id }}" class="variant-pill__label">
                  {{ variant.title }}
                </label>
              {% endfor %}
            </div>
          </div>
          
          <!-- Countdown Premium -->
          {% render 'countdown-timer' %}

          <!-- Regra 9: Lei de Fitts (Botão Gigante Próximo ao Seletor) -->
          <button type="submit" name="add" class="btn-buy" {% unless product.available %}disabled{% endunless %} style="margin-top: 15px;">
            {% if product.available %}
              Comprar Agora
            {% else %}
              Esgotado
            {% endif %}
          </button>
          
          <!-- Selos de Confiança -->
          {% render 'trust-badges' %}
        {% endform %}
      </div>
    </div>
  </div>
</div>

<!-- Sticky Add To Cart -->
{% render 'sticky-add-to-cart' %}

{% stylesheet %}
  .product-main {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 2rem var(--page-margin, 64px);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .breadcrumb {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--color-pinhao, #5C3D2E);
    text-decoration: none;
    font-weight: 500;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb span {
    margin: 0 0.5rem;
  }

  .product-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media screen and (min-width: 900px) {
    .product-layout {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }
    
    /* Regra 2: Razão Áurea (~61.8% e 38.2%) */
    .product-gallery {
      flex: 0 0 calc(61.8% - 1.5rem);
      max-width: calc(61.8% - 1.5rem);
    }
    .product-details {
      flex: 0 0 calc(38.2% - 1.5rem);
      max-width: calc(38.2% - 1.5rem);
      position: sticky;
      top: 7rem; /* Mantém as informações fixas ao descer pelas imagens */
    }
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .product-gallery__item img {
    width: 100%;
    height: auto;
    border-radius: 0;
    object-fit: cover;
  }

  .product-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-title {
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-pinhao, #5C3D2E);
    margin: 0;
    line-height: 1.1;
  }

  /* Hierarquia Visual Elegante nos Preços */
  .product-pricing {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0;
    margin: 1rem 0;
  }
  .product-price--pix {
    font-size: clamp(1.8rem, 2.5vw, 2.2rem);
    font-weight: 400; /* Menos peso, mais elegância */
    color: var(--color-pinhao, #5C3D2E);
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    line-height: 1;
  }
  .pix-label {
    font-size: 0.9rem;
    font-weight: 300;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .product-price--installments {
    font-size: 1rem;
    color: #666;
    font-weight: 300;
  }
  .product-price--original {
    font-size: 0.9rem;
    color: #aaa;
    margin-top: 0.2rem;
  }

  /* Especificações e Descrição */
  .product-description-tech h3 {
    font-size: 0.9rem;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }
  .product-description-tech ul {
    list-style-type: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 1rem;
  }
  .product-description-tech li {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #555;
    position: relative;
    padding-left: 0;
    border-top: 1px solid #eee;
    padding-top: 10px;
  }
  .product-description-tech li::before {
    display: none;
  }
  
  .product-description-full {
    margin-top: 2rem;
    font-size: 0.95rem;
    line-height: 1.8;
    color: #666;
    font-weight: 300;
  }

  /* Variantes Premium */
  .product-form__variants {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }
  .product-form__variants-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .product-form__variants-header label {
    font-weight: 500;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #333;
    margin: 0;
  }
  .btn-size-guide {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-pinhao, #5C3D2E);
    text-decoration: underline;
    cursor: pointer;
    font-weight: 500;
  }
  
  .variant-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .variant-pill__input {
    /* Esconde o radio real */
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  .variant-pill__label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 45px;
    height: 45px;
    padding: 0 1rem;
    border: 1px solid #ccc;
    background-color: transparent;
    color: #333;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .variant-pill__label:hover {
    border-color: #333;
  }
  
  .variant-pill__input:checked + .variant-pill__label {
    background-color: var(--color-pinhao, #5C3D2E);
    color: #fff;
    border-color: var(--color-pinhao, #5C3D2E);
  }
  
  .variant-pill__input:disabled + .variant-pill__label {
    opacity: 0.5;
    text-decoration: line-through;
    cursor: not-allowed;
    background-color: #f9f9f9;
  }

  /* Botão Elegante */
  .btn-buy {
    width: 100%;
    min-height: 60px;
    background-color: #111;
    color: #fff;
    font-size: 1rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border: 1px solid #111;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .btn-buy:hover {
    background-color: transparent;
    color: #111;
  }
  .btn-buy:active {
    transform: scale(0.99);
  }
  .btn-buy:disabled {
    background-color: #f5f5f5;
    border-color: #eee;
    color: #aaa;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produto Principal",
  "settings": [],
  "presets": [
    {
      "name": "Produto Principal"
    }
  ]
}
{% endschema %}
